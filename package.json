    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.0.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
